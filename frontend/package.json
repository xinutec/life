{
  "name": "life-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "stamp": "node scripts/stamp-version.mjs",
    "prestart": "node scripts/stamp-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/stamp-version.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/stamp-version.mjs",
    "test": "ng test --watch=false",
    "prelint": "node scripts/stamp-version.mjs",
    "e2e": "ng build && playwright test",
    "ui-check": "playwright test e2e/ui-pages.spec.ts",
    "ui-golden": "playwright test e2e/ui-golden.spec.ts",
    "offline-check": "playwright test --project offline",
    "ui-golden:update": "playwright test e2e/ui-golden.spec.ts --update-snapshots",
    "lint": "eslint src e2e playwright.config.ts && stylelint \"src/**/*.scss\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@fontsource/roboto": "^5.3.0",
    "@xinutec/ui-harness": "github:xinutec/ui-harness#a3848c2306ba1a67e910baed8dc2870936ad20ea",
    "@xinutec/ui-scaffold": "github:xinutec/ui-harness#a3848c2306ba1a67e910baed8dc2870936ad20ea&path:/scaffold",
    "dexie": "^4.4.4",
    "material-icons": "^1.13.14",
    "rxdb": "^17.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.11"
  }
}
